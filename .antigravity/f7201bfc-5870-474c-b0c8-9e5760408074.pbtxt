        }
        lines {
          text: "    const facingAngle = observer.rotation ?? 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let diff = Math.abs(angleToTarget - facingAngle) % 360;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (diff > 180) diff = 360 - diff;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (diff > 45) return \'out_of_cone\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Distance check"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const dist = (Math.sqrt(dx * dx + dy * dy) / CELL_SIZE) * 1.5;"
