          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        color: outcome === \'crit\' ? \'#ffffff\' : \'#fecaca\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        glowColor: outcome === \'crit\' ? \'#ef4444\' : \'#dc2626\',"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
