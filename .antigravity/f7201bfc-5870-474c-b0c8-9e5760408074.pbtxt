    replacement_infos {
      original_chunk {
        target_content: "    if (targetMode === \'move\') {\n      if (moveSubMode === \'manual\' && moveManualPath) {\n        const last = moveManualPath[moveManualPath.length - 1];\n        const dx = Math.abs(gx - last.gx);\n        const dy = Math.abs(gy - last.gy);\n        if (dx + dy !== 1) return; // apenas c\303\251lulas adjacentes\n        if (!reachableMap.has(`${gx},${gy}`)) return;\n        if (moveManualPath.some(p => p.gx === gx && p.gy === gy)) return; // sem loops\n        setMoveManualPath([...moveManualPath, { gx, gy }]);\n      } else {\n        handleCellClick(gx, gy);\n      }\n      return;\n    }\n  }, [isPanning, zoom, camera, targetMode, moveSubMode, moveManualPath, reachableMap, facingMode, handleCellClick, handleSetFacingClick]);"
        replacement_content: "    if (targetMode === \'grenade\' && selectedUnit) {\n      const fromPos = { x: selectedUnit.x, y: selectedUnit.y };\n      const targetX = gx * CELL_SIZE + CELL_SIZE / 2;\n      const targetY = gy * CELL_SIZE + CELL_SIZE / 2;\n      setTargetMode(null);\n      vfxRef.current?.triggerShot({\n        from: fromPos,\n        to: { x: targetX, y: targetY },\n        role: \'granadeiro\',\n      });\n      setTimeout(() => {\n        vfxRef.current?.triggerExplosion({ x: targetX, y: targetY, radiusPx: 80 });\n      }, 250);\n      withError(() => apiService.throwGrenade(session!.roomId, session!.playerToken, selectedUnit.id, { gx, gy }, 0));\n      return;\n    }\n\n    if (targetMode === \'smoke\' && selectedUnit) {\n      const fromPos = { x: selectedUnit.x, y: selectedUnit.y };\n      const targetX = gx * CELL_SIZE + CELL_SIZE / 2;\n      const targetY = gy * CELL_SIZE + CELL_SIZE / 2;\n      setTargetMode(null);\n      vfxRef.current?.triggerShot({\n        from: fromPos,\n        to: { x: targetX, y: targetY },\n        role: \'granadeiro\',\n      });\n      setTimeout(() => {\n        vfxRef.current?.triggerExplosion({ x: targetX, y: targetY, radiusPx: 60 });\n      }, 250);\n      withError(() => apiService.smokeGrenade(session!.roomId, session!.playerToken, selectedUnit.id, { gx, gy }));\n      return;\n    }\n\n    if (targetMode === \'move\') {\n      if (moveSubMode === \'manual\' && moveManualPath) {\n        const last = moveManualPath[moveManualPath.length - 1];\n        const dx = Math.abs(gx - last.gx);\n        const dy = Math.abs(gy - last.gy);\n        if (dx + dy !== 1) return; // apenas c\303\251lulas adjacentes\n        if (!reachableMap.has(`${gx},${gy}`)) return;\n        if (moveManualPath.some(p => p.gx === gx && p.gy === gy)) return; // sem loops\n        setMoveManualPath([...moveManualPath, { gx, gy }]);\n      } else {\n        handleCellClick(gx, gy);\n      }\n      return;\n    }\n  }, [isPanning, zoom, camera, targetMode, moveSubMode, moveManualPath, reachableMap, facingMode, handleCellClick, handleSetFacingClick, selectedUnit, session]);"
