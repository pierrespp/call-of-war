          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          {/* Highlight my chosen zone cells (brighter)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              Cells inside the zone that are also marked as half/full cover are"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              flagged in red \342\200\224 the player cannot place a token there (Etapa 3). */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          {myZone && myZone.cells.map(cellKey => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
