        }
        lines {
          text: "          {/* Grid */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          {zoom > 0.15 && ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            <div className=\"absolute inset-0 pointer-events-none z-10 mix-blend-overlay opacity-80\" style={{"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              backgroundImage: `linear-gradient(to right, rgba(255,255,255,${zoom < 0.4 ? 0.3 : 0.6}) ${Math.max(1, 2 / zoom)}px, transparent ${Math.max(1, 2 / zoom)}px), linear-gradient(to bottom, rgba(255,255,255,${zoom < 0.4 ? 0.3 : 0.6}) ${Math.max(1, 2 / zoom)}px, transparent ${Math.max(1, 2 / zoom)}px)`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "              backgroundSize: `${CELL_SIZE}px ${CELL_SIZE}px`,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            }} />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          )}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          {/* Cover overlay (read-only display) */}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          {Object.entries(mapCover).map(([key, type]) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (!type || type === \"none\") return null;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            const [gx, gy] = key.split(\",\").map(Number);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            let bgColor = \"transparent\", borderColor = \"transparent\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            if (type === \"half\") { bgColor = \"rgba(234,179,8,0.18)\"; borderColor = \"rgba(234,179,8,0.45)\"; }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            else if (type === \"full\") { bgColor = \"rgba(239,68,68,0.18)\"; borderColor = \"rgba(239,68,68,0.45)\"; }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            else if (type === \"wall\") { bgColor = \"rgba(64,64,64,0.6)\"; borderColor = \"rgba(115,115,115,0.8)\"; }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            else if (type === \"deployA\") { bgColor = \"rgba(96,165,250,0.18)\"; borderColor = \"rgba(96,165,250,0.5)\"; }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            else if (type === \"deployB\") { bgColor = \"rgba(252,165,165,0.18)\"; borderColor = \"rgba(252,165,165,0.5)\"; }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "            else if (type === \"water\") { bgColor = \"rgba(30,64,175,0.4)\"; borderColor = \"rgba(30,64,175,0.7)\"; }"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
