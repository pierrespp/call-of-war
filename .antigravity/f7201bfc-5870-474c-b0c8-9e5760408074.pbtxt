        lines {
          text: "  const dirs = ["
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    { dx:  0, dy: -1, dir: \'N\', left: gx * CELL_SIZE + CELL_SIZE / 2, top: gy * CELL_SIZE },"
