        lines {
          text: "      for (let i = 0; i < tracersRef.current.length; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const tracer = tracersRef.current[i];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const totalDist = Math.hypot(tracer.targetX - tracer.startX, tracer.targetY - tracer.startY);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const dirX = (tracer.targetX - tracer.startX) / totalDist;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        const dirY = (tracer.targetY - tracer.startY) / totalDist;"
