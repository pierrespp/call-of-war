        }
        lines {
          text: "        onWheel={(e) => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const newZoom = e.deltaY < 0 ? zoom * 1.08 : zoom / 1.08;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          setZoom(Math.min(Math.max(0.05, newZoom), 8));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        onMouseDown={(e) => { if (e.button === 1 || e.button === 2) setIsPanning(true); }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        onMouseMove={(e) => { if (isPanning) setCamera(prev => ({ x: prev.x - e.movementX / zoom, y: prev.y - e.movementY / zoom })); }}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        onMouseUp={() => setIsPanning(false)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        onMouseLeave={() => setIsPanning(false)}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
