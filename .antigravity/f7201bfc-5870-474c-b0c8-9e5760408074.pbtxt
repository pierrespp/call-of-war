    replacement_chunks {
      target_content: "    if (targetMode === \'shoot\' || targetMode === \'suppress\') {\n      if (target.team === playerTeam) { setActionError(\'Alvo inv\303\241lido.\'); return; }\n      const atk = selectedUnit;\n      const dx = target.x - atk.x; const dy = target.y - atk.y;\n      const distM = (Math.sqrt(dx * dx + dy * dy) / CELL_SIZE) * 1.5;\n      const weapon = WEAPONS[atk.activeWeaponSlot === \'secondary\' ? atk.secondaryWeapon ?? \'\' : atk.primaryWeapon ?? \'\'];\n      let distPenalty = 0;\n      if (weapon) {\n        const range = weapon.range === \'Curto\' ? 20 : weapon.range === \'M\303\251dio\' ? 40 : 60;\n        const perM = weapon.range === \'Curto\' ? 2 : weapon.range === \'M\303\251dio\' ? 1 : 0.5;\n        distPenalty = Math.max(0, (distM - range) * perM);\n      }\n      setTargetMode(null);\n      if (targetMode === \'suppress\') {\n        await withError(() => apiService.suppressUnit(session.roomId, session.playerToken, atk.id, unitId));\n      } else {\n        await withError(() => apiService.shootUnit(session.roomId, session.playerToken, atk.id, unitId, distPenalty));\n      }\n    } else if (targetMode === \'heal\') {"
      replacement_content: "    if (targetMode === \'shoot\' || targetMode === \'suppress\') {\n      if (target.team === playerTeam) { setActionError(\'Alvo inv\303\241lido.\'); return; }\n      const atk = selectedUnit;\n      const dx = target.x - atk.x; const dy = target.y - atk.y;\n      const distM = (Math.sqrt(dx * dx + dy * dy) / CELL_SIZE) * 1.5;\n      const weapon = WEAPONS[atk.activeWeaponSlot === \'secondary\' ? atk.secondaryWeapon ?? \'\' : atk.primaryWeapon ?? \'\'];\n      let distPenalty = 0;\n      if (weapon) {\n        const range = weapon.range === \'Curto\' ? 20 : weapon.range === \'M\303\251dio\' ? 40 : 60;\n        const perM = weapon.range === \'Curto\' ? 2 : weapon.range === \'M\303\251dio\' ? 1 : 0.5;\n        distPenalty = Math.max(0, (distM - range) * perM);\n      }\n      setTargetMode(null);\n      const fromPos = { x: atk.x, y: atk.y };\n      const toPos = { x: target.x, y: target.y };\n      const atkRole = atk.className.toLowerCase();\n\n      if (targetMode === \'suppress\') {\n        vfxRef.current?.triggerShot({\n          from: fromPos,\n          to: toPos,\n          outcome: \'hit\',\n          role: atkRole,\n        });\n        await withError(() => apiService.suppressUnit(session.roomId, session.playerToken, atk.id, unitId));\n      } else {\n        const res = await withError(() => apiService.shootUnit(session.roomId, session.playerToken, atk.id, unitId, distPenalty));\n        if (res) {\n          const outcome = res.shotResult?.isCrit ? \'crit\' : res.shotResult?.hit ? \'hit\' : \'miss\';\n          vfxRef.current?.triggerShot({\n            from: fromPos,\n            to: toPos,\n            outcome,\n            role: atkRole,\n            damage: res.shotResult?.damage,\n          });\n        }\n      }\n    } else if (targetMode === \'heal\') {"
