          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (diff > 180) diff = 360 - diff;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (diff > 45) return \'out_of_cone\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Distance check"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
