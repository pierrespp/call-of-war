          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          text: "Implementamos a funcionalidade completa de **Editor de Mapas por Tiles / Sprites e Presets Modulares**, permitindo carimbar terrenos, paredes, props de cobertura (carros, ca\303\247ambas, sacos de areia) e portas/janelas diretamente sobre o grid de combate t\303\241tico, com sincroniza\303\247\303\243o imediata com as regras de combate e pathfinding."
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_DELETE
