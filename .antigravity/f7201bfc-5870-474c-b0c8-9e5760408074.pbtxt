  file_change {
    absolute_path_uri: "file:///src/features/match-setup/components/DeployScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useEffect, useMemo, useRef, useState } from \"react\";\nimport { CELL_SIZE, CLASSES } from \'@/src/core/data/constants\';\nimport { useMaps } from \'@/src/core/contexts/MapContext\';\nimport { apiService, RoomStateResponse } from \'@/src/core/services/apiService\';\nimport { DeployZone, DraftUnit, MapCoverData } from \'@/src/types/game\';\nimport { Check, X, ArrowLeft } from \"lucide-react\";\nimport { getImageUrl } from \'@/src/lib/utils\';\nimport { useImages } from \'@/src/core/contexts/ImageContext\';\n\ninterface Props {\n  roomId: string;\n  playerToken: string;\n  playerTeam: \"A\" | \"B\";\n  state: RoomStateResponse;\n  onLeave: () => void;\n}\n\nexport function DeployScreen({ roomId, playerToken, playerTeam, state, onLeave }: Props) {\n  const { getMapImage } = useImages();\n  const { maps } = useMaps();\n  const mapId = state.draft.selectedMap;\n  const mapInfo = maps[mapId];\n  const myDraft: DraftUnit[] = state.draft.teams[playerTeam] || [];\n  const myReady = state.deploy.ready[playerTeam];\n  const opponentTeam = playerTeam === \"A\" ? \"B\" : \"A\";\n  const opponentReady = state.deploy.ready[opponentTeam];\n  const opponentName = state.players[opponentTeam]?.name;\n\n  const [zones, setZones] = useState<{ A: DeployZone[]; B: DeployZone[] }>({ A: [], B: [] });\n  const [mapCover, setMapCover] = useState<MapCoverData>({});\n  const [zoom, setZoom] = useState(0.4);\n  const [camera, setCamera] = useState({ x: 1000, y: 1000 });\n  const [isPanning, setIsPanning] = useState(false);\n  const [selectedUnitId, setSelectedUnitId] = useState<string | null>(null);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [savingReady, setSavingReady] = useState(false);\n\n  // Local positions (synced with server). On server change we hydrate.\n  const [positions, setPositions] = useState<Record<string, { gx: number; gy: number }>>({});\n\n  useEffect(() => {\n    apiService.getDeployZones(roomId).then(setZones).catch(() => {});\n    apiService.getMapCover(roomId, mapId).then(setMapCover).catch(() => {});\n  }, [roomId, mapId]);"
      replacement_content: "import React, { useEffect, useMemo, useRef, useState } from \"react\";\nimport { CELL_SIZE, CLASSES } from \'@/src/core/data/constants\';\nimport { useMaps } from \'@/src/core/contexts/MapContext\';\nimport { apiService, RoomStateResponse } from \'@/src/core/services/apiService\';\nimport { DeployZone, DraftUnit, MapCoverData } from \'@/src/types/game\';\nimport { Check, X, ArrowLeft } from \"lucide-react\";\nimport { getImageUrl } from \'@/src/lib/utils\';\nimport { BUILTIN_TILESETS } from \'@/src/core/data/tilesets\';\nimport { createTileLookup } from \'@/src/utils/tilesetUtils\';\nimport { MapCellTile, MapTileData } from \'@/src/types/tileset\';\n\ninterface Props {\n  roomId: string;\n  playerToken: string;\n  playerTeam: \"A\" | \"B\";\n  state: RoomStateResponse;\n  onLeave: () => void;\n  onRefreshState?: () => void;\n}\n\nexport function DeployScreen({ roomId, playerToken, playerTeam, state, onLeave, onRefreshState }: Props) {\n  const { maps } = useMaps();\n  const mapId = state.draft.selectedMap;\n  const mapInfo = maps[mapId];\n  const myDraft: DraftUnit[] = state.draft.teams[playerTeam] || [];\n  const myReady = state.deploy.ready[playerTeam];\n  const opponentTeam = playerTeam === \"A\" ? \"B\" : \"A\";\n  const opponentReady = state.deploy.ready[opponentTeam];\n  const opponentName = state.players[opponentTeam]?.name;\n\n  const [zones, setZones] = useState<{ A: DeployZone[]; B: DeployZone[] }>({ A: [], B: [] });\n  const [mapCover, setMapCover] = useState<MapCoverData>({});\n  const [tilesData, setTilesData] = useState<MapTileData>({});\n  const tileLookup = useMemo(() => createTileLookup(BUILTIN_TILESETS), []);\n  const tileCanvasRef = useRef<HTMLCanvasElement>(null);\n  const tileImagesCache = useRef<Record<string, HTMLImageElement>>({});\n\n  const [zoom, setZoom] = useState(0.4);\n  const [camera, setCamera] = useState({ x: 1000, y: 1000 });\n  const [isPanning, setIsPanning] = useState(false);\n  const [selectedUnitId, setSelectedUnitId] = useState<string | null>(null);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [savingReady, setSavingReady] = useState(false);\n\n  // Local positions (synced with server). On server change we hydrate.\n  const [positions, setPositions] = useState<Record<string, { gx: number; gy: number }>>({});\n\n  useEffect(() => {\n    apiService.getDeployZones(roomId).then(setZones).catch(() => {});\n    apiService.getMapCover(roomId, mapId).then(setMapCover).catch(() => {});\n    if (mapId) {\n      fetch(`/api/maps/${mapId}/tiles`)\n        .then(res => res.ok ? res.json() : {})\n        .then(data => setTilesData(data || {}))\n        .catch(() => setTilesData({}));\n    }\n  }, [roomId, mapId]);\n\n  const mapW = (mapInfo?.gridWidth || 20) * CELL_SIZE;\n  const mapH = (mapInfo?.gridHeight || 20) * CELL_SIZE;\n\n  // Pr\303\251-renderiza os tiles no canvas quando tilesData mudar ou imagens carregarem\n  useEffect(() => {\n    const canvas = tileCanvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n    const tileEntries = Object.entries(tilesData);\n    if (tileEntries.length === 0) return;\n\n    const renderAllTiles = () => {\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n      for (const [key, cellTile] of tileEntries) {\n        const tile = cellTile as MapCellTile;\n        if (!tile) continue;\n        const tileDef = tileLookup[tile.tileId];\n        if (!tileDef) continue;\n\n        const [gx, gy] = key.split(\',\').map(Number);\n        const cellX = gx * CELL_SIZE;\n        const cellY = gy * CELL_SIZE;\n\n        const img = tileImagesCache.current[tile.tileId];\n        if (img && img.complete) {\n          ctx.save();\n          if (tile.rotation) {\n            ctx.translate(cellX + CELL_SIZE / 2, cellY + CELL_SIZE / 2);\n            ctx.rotate((tile.rotation * Math.PI) / 180);\n            ctx.drawImage(img, -CELL_SIZE / 2, -CELL_SIZE / 2, CELL_SIZE, CELL_SIZE);\n          } else {\n            ctx.drawImage(img, cellX, cellY, CELL_SIZE, CELL_SIZE);\n          }\n          ctx.restore();\n        }\n      }\n    };\n\n    tileEntries.forEach(([_, cellTile]) => {\n      const tile = cellTile as MapCellTile;\n      if (!tile) return;\n      const tileDef = tileLookup[tile.tileId];\n      if (!tileDef) return;\n\n      if (!tileImagesCache.current[tile.tileId]) {\n        const img = new Image();\n        img.src = tileDef.imagePath;\n        img.onload = () => {\n          tileImagesCache.current[tile.tileId] = img;\n          renderAllTiles();\n        };\n      }\n    });\n\n    renderAllTiles();\n  }, [tilesData, tileLookup, mapW, mapH]);"
    }
