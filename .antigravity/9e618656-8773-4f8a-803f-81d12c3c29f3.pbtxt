        }
        lines {
          text: "          "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          // L\303\263gica de Visibilidade:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          // 1. Unidades aliadas sempre vis\303\255veis."
