        lines {
          text: "  const getFovState = useCallback((observer: Unit | null, target: Unit): \'visible\' | \'marked\' | \'obstructed\' | \'out_of_cone\' | null => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (!observer || observer.team === target.team) return null;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Marked target"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (observer.markedTargetId === target.id) return \'marked\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Compute cover \342\200\224 wall blocks"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const coverResult = computeShotCover(observer.x, observer.y, target.x, target.y, mapCoverConfig);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (coverResult.hasWall) return \'obstructed\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
