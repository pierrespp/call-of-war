  file_change {
    absolute_path_uri: "file:///scripts/test_tileset.ts"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import http from \'http\';\nimport fs from \'fs\';\nimport path from \'path\';\n\nfunction request(options: http.RequestOptions, body?: any): Promise<{ status: number; data: any }> {\n  return new Promise((resolve, reject) => {\n    const req = http.request(options, (res) => {\n      let data = \'\';\n      res.on(\'data\', (chunk) => { data += chunk; });\n      res.on(\'end\', () => {\n        try {\n          const parsed = JSON.parse(data);\n          resolve({ status: res.statusCode || 0, data: parsed });\n        } catch {\n          resolve({ status: res.statusCode || 0, data });\n        }\n      });\n    });\n    req.on(\'error\', reject);\n    if (body) {\n      req.write(typeof body === \'string\' ? body : JSON.stringify(body));\n    }\n    req.end();\n  });\n}\n\nasync function runTests() {\n  console.log(\'\360\237\247\252 [TESTES] Iniciando valida\303\247\303\243o do Editor de Mapas e Tilesets...\');\n\n  // 1. Validar manifest.json\n  const manifestRes = await request({\n    hostname: \'localhost\',\n    port: 3000,\n    path: \'/tiles/urban/manifest.json\',\n    method: \'GET\'\n  });\n  console.log(`[1/5] GET /tiles/urban/manifest.json -> HTTP ${manifestRes.status} (Tiles: ${manifestRes.data?.tiles?.length || 0})`);\n\n  // 2. Validar carregamento de sprites SVG\n  const testTiles = [\n    \'/tiles/urban/asphalt_clean.svg\',\n    \'/tiles/urban/asphalt_cracked.svg\',\n    \'/tiles/urban/sidewalk.svg\',\n    \'/tiles/urban/brick_wall.svg\',\n    \'/tiles/urban/concrete_barrier.svg\',\n    \'/tiles/urban/car_wreck.svg\',\n    \'/tiles/urban/sandbags.svg\',\n    \'/tiles/urban/puddle.svg\',\n    \'/tiles/urban/door_closed.svg\',\n    \'/tiles/urban/window.svg\'\n  ];\n\n  let assetsOk = true;\n  for (const t of testTiles) {\n    const assetRes = await request({\n      hostname: \'localhost\',\n      port: 3000,\n      path: t,\n      method: \'GET\'\n    });\n    if (assetRes.status !== 200) {\n      console.error(`\342\235\214 Falha ao carregar sprite: ${t} -> HTTP ${assetRes.status}`);\n      assetsOk = false;\n    }\n  }\n  if (assetsOk) {\n    console.log(`[2/5] Todos os ${testTiles.length} sprites de tilesets responderam com HTTP 200 OK.`);\n  }\n\n  // 3. Testar POST e GET de tiles (/api/maps/:mapId/tiles)\n  const testMapId = \'map-silent-run\';\n  const testTilesPayload = {\n    \"0,0\": { tileId: \"asphalt_clean\" },\n    \"1,0\": { tileId: \"asphalt_cracked\" },\n    \"2,0\": { tileId: \"car_wreck\", rotation: 90 }\n  };\n\n  const saveTilesRes = await request({\n    hostname: \'localhost\',\n    port: 3000,\n    path: `/api/maps/${testMapId}/tiles`,\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' }\n  }, { tiles: testTilesPayload });\n\n  console.log(`[3/5] POST /api/maps/${testMapId}/tiles -> HTTP ${saveTilesRes.status} (${JSON.stringify(saveTilesRes.data)})`);\n\n  const getTilesRes = await request({\n    hostname: \'localhost\',\n    port: 3000,\n    path: `/api/maps/${testMapId}/tiles`,\n    method: \'GET\'\n  });\n  console.log(`[4/5] GET /api/maps/${testMapId}/tiles -> HTTP ${getTilesRes.status} (Tiles recuperados: ${Object.keys(getTilesRes.data?.tiles || {}).length})`);\n\n  // 4. Testar POST e GET de cover (/api/maps/:mapId/cover)\n  const testCoverPayload = {\n    \"0,0\": \"none\",\n    \"1,0\": \"none\",\n    \"2,0\": \"half\"\n  };\n\n  const saveCoverRes = await request({\n    hostname: \'localhost\',\n    port: 3000,\n    path: `/api/maps/${testMapId}/cover`,\n    method: \'POST\',\n    headers: { \'Content-Type\': \'application/json\' }\n  }, { cover: testCoverPayload });\n\n  console.log(`[5/5] POST /api/maps/${testMapId}/cover -> HTTP ${saveCoverRes.status} (${JSON.stringify(saveCoverRes.data)})`);\n\n  console.log(\'\\n\360\237\216\211 [SUCESSO] Todos os testes do backend, manifesto de tiles, assets e persist\303\252ncia foram aprovados!\');\n}\n\nrunTests().catch(console.error);\n"
    }
