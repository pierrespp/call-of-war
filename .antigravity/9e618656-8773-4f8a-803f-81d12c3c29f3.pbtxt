    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "{\n  \"id\": \"urban_ruins\",\n  \"name\": \"Zona Urbana & Ru\303\255nas\",\n  \"description\": \"Tilesets modulares para ruas, avenidas, cal\303\247adas, becos e combate t\303\241tico urbano.\",\n  \"tiles\": [\n    {\n      \"id\": \"asphalt_clean\",\n      \"name\": \"Asfalto Liso\",\n      \"category\": \"floor\",\n      \"imagePath\": \"/tiles/urban/asphalt_clean.svg\",\n      \"coverType\": \"none\",\n      \"description\": \"Via aberta sem cobertura. Movimento padr\303\243o.\"\n    },\n    {\n      \"id\": \"asphalt_cracked\",\n      \"name\": \"Asfalto Trincado\",\n      \"category\": \"floor\",\n      \"imagePath\": \"/tiles/urban/asphalt_cracked.svg\",\n      \"coverType\": \"none\",\n      \"description\": \"Asfalto deteriorado por combate.\"\n    },\n    {\n      \"id\": \"sidewalk_tile\",\n      \"name\": \"Cal\303\247ada de Concreto\",\n      \"category\": \"floor\",\n      \"imagePath\": \"/tiles/urban/sidewalk_tile.svg\",\n      \"coverType\": \"none\",\n      \"description\": \"Piso de concreto para pedestres.\"\n    },\n    {\n      \"id\": \"indoor_floor\",\n      \"name\": \"Piso Interno\",\n      \"category\": \"floor\",\n      \"imagePath\": \"/tiles/urban/indoor_floor.svg\",\n      \"coverType\": \"none\",\n      \"description\": \"Ch\303\243o interno de constru\303\247\303\265es e pr\303\251dios.\"\n    },\n    {\n      \"id\": \"puddle_water\",\n      \"name\": \"Po\303\247a d\'\303\201gua / Lama\",\n      \"category\": \"liquid\",\n      \"imagePath\": \"/tiles/urban/puddle_water.svg\",\n      \"coverType\": \"water\",\n      \"description\": \"\303\201gua / Lama. Cada c\303\251lula custa o dobro de movimento (3m).\"\n    },\n    {\n      \"id\": \"brick_wall\",\n      \"name\": \"Parede de Alvenaria\",\n      \"category\": \"wall\",\n      \"imagePath\": \"/tiles/urban/brick_wall.svg\",\n      \"coverType\": \"wall\",\n      \"rotatable\": true,\n      \"description\": \"Parede s\303\263lida de tijolos. Bloqueia linha de vis\303\243o e tiros.\"\n    },\n    {\n      \"id\": \"concrete_barrier\",\n      \"name\": \"Barreira de Concreto\",\n      \"category\": \"cover\",\n      \"imagePath\": \"/tiles/urban/concrete_barrier.svg\",\n      \"coverType\": \"half\",\n      \"rotatable\": true,\n      \"description\": \"Mureta de concreto militar / Jersey. Meia Cobertura (-20% hit).\"\n    },\n    {\n      \"id\": \"sandbags\",\n      \"name\": \"Sacos de Areia\",\n      \"category\": \"cover\",\n      \"imagePath\": \"/tiles/urban/sandbags.svg\",\n      \"coverType\": \"half\",\n      \"rotatable\": true,\n      \"description\": \"Entrincheiramento t\303\241tico. Meia Cobertura (-20% hit).\"\n    },\n    {\n      \"id\": \"car_wreck\",\n      \"name\": \"Carro Destru\303\255do\",\n      \"category\": \"cover\",\n      \"imagePath\": \"/tiles/urban/car_wreck.svg\",\n      \"coverType\": \"full\",\n      \"rotatable\": true,\n      \"description\": \"Ve\303\255culo incendiado / carca\303\247a. Cobertura Total (-40% hit).\"\n    },\n    {\n      \"id\": \"dumpster\",\n      \"name\": \"Ca\303\247amba de Lixo\",\n      \"category\": \"cover\",\n      \"imagePath\": \"/tiles/urban/dumpster.svg\",\n      \"coverType\": \"full\",\n      \"rotatable\": true,\n      \"description\": \"Ca\303\247amba de a\303\247o pesada em becos. Cobertura Total (-40% hit).\"\n    },\n    {\n      \"id\": \"wooden_crates\",\n      \"name\": \"Caixas de Suprimento\",\n      \"category\": \"cover\",\n      \"imagePath\": \"/tiles/urban/wooden_crates.svg\",\n      \"coverType\": \"half\",\n      \"rotatable\": true,\n      \"description\": \"Caixas militares de madeira. Meia Cobertura (-20% hit).\"\n    },\n    {\n      \"id\": \"door_closed\",\n      \"name\": \"Porta de A\303\247o (Fechada)\",\n      \"category\": \"door\",\n      \"imagePath\": \"/tiles/urban/door_closed.svg\",\n      \"coverType\": \"doorClose\",\n      \"rotatable\": true,\n      \"description\": \"Porta fechada. Bloqueia vis\303\243o/tiro at\303\251 ser aberta por uma unidade.\"\n    },\n    {\n      \"id\": \"door_open\",\n      \"name\": \"Porta de A\303\247o (Aberta)\",\n      \"category\": \"door\",\n      \"imagePath\": \"/tiles/urban/door_open.svg\",\n      \"coverType\": \"doorOpen\",\n      \"rotatable\": true,\n      \"description\": \"Passagem aberta atrav\303\251s de uma parede.\"\n    },\n    {\n      \"id\": \"window_frame\",\n      \"name\": \"Janela Quebrada\",\n      \"category\": \"window\",\n      \"imagePath\": \"/tiles/urban/window_frame.svg\",\n      \"coverType\": \"window\",\n      \"rotatable\": true,\n      \"description\": \"Permite linha de tiro e vis\303\243o com meia cobertura.\"\n    }\n  ]\n}\n"
