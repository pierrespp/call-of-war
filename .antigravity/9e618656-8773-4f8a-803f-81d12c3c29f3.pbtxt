    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "  const [tilesData, setTilesData] = React.useState<MapTileData>({});\n  const tileLookup = React.useMemo(() => createTileLookup(BUILTIN_TILESETS), []);\n\n  React.useEffect(() => {\n    if (!gameState.mapId) return;\n    fetch(`/api/maps/${gameState.mapId}/tiles`)\n      .then(res => res.ok ? res.json() : {})\n      .then(data => setTilesData(data || {}))\n      .catch(() => setTilesData({}));\n  }, [gameState.mapId]);\n"
      replacement_content: "  const [tilesData, setTilesData] = React.useState<MapTileData>({});\n  const tileLookup = React.useMemo(() => createTileLookup(BUILTIN_TILESETS), []);\n  const tileCanvasRef = React.useRef<HTMLCanvasElement>(null);\n  const tileImagesCache = React.useRef<Record<string, HTMLImageElement>>({});\n\n  React.useEffect(() => {\n    if (!gameState.mapId) return;\n    fetch(`/api/maps/${gameState.mapId}/tiles`)\n      .then(res => res.ok ? res.json() : {})\n      .then(data => setTilesData(data || {}))\n      .catch(() => setTilesData({}));\n  }, [gameState.mapId]);\n\n  // Pr\303\251-renderiza os tiles no canvas quando tilesData mudar ou imagens carregarem\n  React.useEffect(() => {\n    const canvas = tileCanvasRef.current;\n    if (!canvas) return;\n    const ctx = canvas.getContext(\'2d\');\n    if (!ctx) return;\n\n    ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n    const tileEntries = Object.entries(tilesData);\n    if (tileEntries.length === 0) return;\n\n    let loadedCount = 0;\n    const totalTiles = tileEntries.length;\n\n    const renderAllTiles = () => {\n      ctx.clearRect(0, 0, canvas.width, canvas.height);\n      for (const [key, cellTile] of tileEntries) {\n        const tile = cellTile as MapCellTile;\n        if (!tile) continue;\n        const tileDef = tileLookup[tile.tileId];\n        if (!tileDef) continue;\n\n        const [gx, gy] = key.split(\',\').map(Number);\n        const cellX = gx * CELL_SIZE;\n        const cellY = gy * CELL_SIZE;\n\n        const img = tileImagesCache.current[tile.tileId];\n        if (img && img.complete) {\n          ctx.save();\n          if (tile.rotation) {\n            ctx.translate(cellX + CELL_SIZE / 2, cellY + CELL_SIZE / 2);\n            ctx.rotate((tile.rotation * Math.PI) / 180);\n            ctx.drawImage(img, -CELL_SIZE / 2, -CELL_SIZE / 2, CELL_SIZE, CELL_SIZE);\n          } else {\n            ctx.drawImage(img, cellX, cellY, CELL_SIZE, CELL_SIZE);\n          }\n          ctx.restore();\n        }\n      }\n    };\n\n    tileEntries.forEach(([_, cellTile]) => {\n      const tile = cellTile as MapCellTile;\n      if (!tile) return;\n      const tileDef = tileLookup[tile.tileId];\n      if (!tileDef) return;\n\n      if (!tileImagesCache.current[tile.tileId]) {\n        const img = new Image();\n        img.src = tileDef.imagePath;\n        img.onload = () => {\n          tileImagesCache.current[tile.tileId] = img;\n          renderAllTiles();\n        };\n      }\n    });\n\n    renderAllTiles();\n  }, [tilesData, tileLookup, mapW, mapH]);\n"
    }
