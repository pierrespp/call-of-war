        lines {
          text: "    const dy = target.y - observer.y;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const angleToTarget = Math.atan2(dy, dx) * (180 / Math.PI);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const facingAngle = observer.rotation ?? 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
