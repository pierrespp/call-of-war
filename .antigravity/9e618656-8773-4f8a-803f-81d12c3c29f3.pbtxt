        }
        lines {
          text: "      dpValue *= Math.max(0.2, Math.min(1, hpRatio)); // No m\303\255nimo 20% do valor de DP pra n\303\243o desconsiderar um zumbi com 1hp"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
