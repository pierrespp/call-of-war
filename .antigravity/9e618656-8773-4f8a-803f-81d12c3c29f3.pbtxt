        lines {
          text: "  if (!hasLineOfSight(observer.x, observer.y, target.x, target.y, mapCover)) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    return false;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
