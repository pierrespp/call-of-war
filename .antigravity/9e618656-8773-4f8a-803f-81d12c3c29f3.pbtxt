        lines {
          text: "function calcDraftUnitCost(u: DraftUnit): number {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  let sum = 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (u.className) sum += CLASSES[u.className]?.points || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (u.primaryWeapon) sum += WEAPONS[u.primaryWeapon]?.points || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (u.secondaryWeapon) sum += WEAPONS[u.secondaryWeapon]?.points || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (u.armorName) sum += ARMORS[u.armorName]?.points || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  for (const a of u.attachments || []) sum += ATTACHMENTS[a]?.points || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  for (const s of u.skills || []) sum += SKILLS[s]?.points || 0;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  return sum;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
