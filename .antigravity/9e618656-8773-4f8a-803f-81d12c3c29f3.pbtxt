        }
        lines {
          text: "  function calculateZombiesTargetDP(room: Room): number {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const isHard = room.gameState.difficulty === \"hard\";"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let base = isHard ? 25 : 15;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const aUnits = Object.values(room.gameState.units).filter((u) => u.team === \"A\" && u.hp > 0);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Modifier 1: Players / Units (+5 ou +7 DP por jogador vivo)"
