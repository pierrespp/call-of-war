          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // If the editor never added any deploy zones for this map, fall back to factory defaults"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // so that a fresh install can play immediately without opening the editor first."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
