        }
        lines {
          text: "function calcDraftTeamCost(units: DraftUnit[]): number {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  return units.reduce((acc, u) => acc + calcDraftUnitCost(u), 0);"
