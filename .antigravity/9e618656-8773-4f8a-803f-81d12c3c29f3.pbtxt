        }
        lines {
          text: "    "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Modifier 2: Turn number (escalation over time, +5% a cada turno)"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const turnMultiplier = 1 + (room.gameState.turnNumber * 0.05);"
