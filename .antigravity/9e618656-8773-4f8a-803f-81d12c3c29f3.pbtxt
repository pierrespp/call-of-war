          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // 2. Extens\303\243o frontal al\303\251m de 40m"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
