          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const fovState = (targetMode === \'shoot\' || targetMode === \'suppress\' || targetMode === \'mark\')"
