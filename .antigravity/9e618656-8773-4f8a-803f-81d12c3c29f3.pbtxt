    instruction: "Render SandboxToggle in CreateMatchMenu, DeployScreen, and improve its UI styling and responsiveness"
    replacement_infos {
      original_chunk {
        target_content: "  const SandboxToggle = () => {\n    if (!sandboxTokens || !session) return null;\n    const isA = session.playerTeam === \'A\';\n    return (\n      <button\n        onClick={() => {\n          const nextTeam = isA ? \'B\' : \'A\';\n          const nextToken = sandboxTokens[nextTeam];\n          setSession({ ...session, playerTeam: nextTeam, playerToken: nextToken });\n          apiService.saveSession({ ...session, playerTeam: nextTeam, playerToken: nextToken, sandboxTokens });\n        }}\n        className=\"fixed top-4 left-4 z-[999] bg-orange-600 hover:bg-orange-500 text-white font-bold py-2 px-4 rounded-xl shadow-lg border border-orange-400 flex items-center gap-2 transition-all hover:scale-105\"\n      >\n        <Users size={16} /> Sandbox: Equipe {session.playerTeam} (Clique para mudar)\n      </button>\n    );\n  };"
        replacement_content: "  const SandboxToggle = () => {\n    if (!sandboxTokens || !session) return null;\n    const isA = session.playerTeam === \'A\';\n    return (\n      <div className=\"fixed top-4 left-4 z-[9999] flex items-center gap-2\">\n        <button\n          onClick={() => {\n            const nextTeam = isA ? \'B\' : \'A\';\n            const nextToken = sandboxTokens[nextTeam];\n            const updated = { ...session, playerTeam: nextTeam, playerToken: nextToken, sandboxTokens };\n            setSession(updated);\n            apiService.saveSession(updated);\n          }}\n          className={cn(\n            \"group flex items-center gap-3 px-4 py-2.5 rounded-xl font-mono text-xs font-black uppercase tracking-wider transition-all shadow-2xl border active:scale-95 backdrop-blur-md\",\n            isA\n              ? \"bg-blue-600/90 hover:bg-blue-500 text-white border-blue-400/50 shadow-blue-900/40\"\n              : \"bg-red-600/90 hover:bg-red-500 text-white border-red-400/50 shadow-red-900/40\"\n          )}\n          title=\"Clique para alternar entre Jogador A e Jogador B no Sandbox\"\n        >\n          <div className=\"w-2.5 h-2.5 rounded-full bg-amber-400 animate-ping\" />\n          <span className=\"flex items-center gap-1.5\">\n            <Users size={15} />\n            SANDBOX: <span className=\"underline decoration-2 underline-offset-2\">{isA ? \'EQUIPE A (EUA)\' : \'EQUIPE B (TERROR)\'}</span>\n          </span>\n          <span className=\"text-[10px] bg-black/40 px-2 py-0.5 rounded border border-white/20 ml-1 text-amber-300\">\n            Trocar \342\236\224\n          </span>\n        </button>\n      </div>\n    );\n  };"
      }
      num_matches: 1
    }
  }
}
