        target_content: "  // \342\224\200\342\224\200 Create Match \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\n  if (appState === \'createMatch\' && session) {\n    if (!roomState) {\n      return (\n        <div className=\"min-h-screen bg-neutral-950 flex items-center justify-center\">\n          <div className=\"text-neutral-500 font-mono text-xs animate-pulse\">Conectando \303\240 sala...</div>\n        </div>\n      );\n    }\n    return (\n      <ScreenWrapper>\n        <CreateMatchMenu\n          roomId={session.roomId}\n          playerToken={session.playerToken}\n          playerTeam={playerTeam}\n          state={roomState}\n          onBack={() => {\n            apiService.clearSession();\n            setSession(null);\n            setRoomState(null);\n            setAppState(\'lobby\');\n          }}\n          onMatchReady={() => setAppState(\'deploy\')}\n        />\n      </ScreenWrapper>\n    );\n  }\n\n  // \342\224\200\342\224\200 Deploy \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\n  if ((appState === \'deploy\' || appState === \'waiting\') && session) {\n    return (\n      <div className=\"min-h-screen w-full bg-neutral-950 flex flex-col\">\n        <DeployScreen\n          roomId={session.roomId}\n          playerToken={session.playerToken}\n          playerTeam={playerTeam}\n          state={roomState!}\n          onLeave={() => { apiService.clearSession(); setSession(null); setRoomState(null); setAppState(\'lobby\'); }}\n        />\n      </div>\n    );\n  }"
        replacement_content: "  // \342\224\200\342\224\200 Create Match \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\n  if (appState === \'createMatch\' && session) {\n    if (!roomState) {\n      return (\n        <div className=\"min-h-screen bg-neutral-950 flex items-center justify-center\">\n          <div className=\"text-neutral-500 font-mono text-xs animate-pulse\">Conectando \303\240 sala...</div>\n        </div>\n      );\n    }\n    return (\n      <ScreenWrapper>\n        <SandboxToggle />\n        <CreateMatchMenu\n          roomId={session.roomId}\n          playerToken={session.playerToken}\n          playerTeam={playerTeam}\n          state={roomState}\n          onBack={() => {\n            apiService.clearSession();\n            setSession(null);\n            setRoomState(null);\n            setAppState(\'lobby\');\n          }}\n          onMatchReady={() => setAppState(\'deploy\')}\n        />\n      </ScreenWrapper>\n    );\n  }\n\n  // \342\224\200\342\224\200 Deploy \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\n  if ((appState === \'deploy\' || appState === \'waiting\') && session) {\n    return (\n      <div className=\"min-h-screen w-full bg-neutral-950 flex flex-col relative\">\n        <SandboxToggle />\n        <DeployScreen\n          roomId={session.roomId}\n          playerToken={session.playerToken}\n          playerTeam={playerTeam}\n          state={roomState!}\n          onLeave={() => { apiService.clearSession(); setSession(null); setRoomState(null); setAppState(\'lobby\'); }}\n        />\n      </div>\n    );\n  }"
      }
      num_matches: 1
    }
  }
