        }
        lines {
          text: "function pathHitsWall("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  room: Room,"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
