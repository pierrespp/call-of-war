          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          const isVisible = !isEnemy || revealMap || rawFov === \'visible\' || rawFov === \'marked\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
