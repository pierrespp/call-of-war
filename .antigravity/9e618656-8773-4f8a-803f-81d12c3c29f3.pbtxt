        lines {
          text: "    const cy = sy + (ty - sy) * t;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const key = `${Math.floor(cx / CELL_SIZE)},${Math.floor(cy / CELL_SIZE)}`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (key === startCell) continue;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (cover[key] === \"wall\") return true;"
