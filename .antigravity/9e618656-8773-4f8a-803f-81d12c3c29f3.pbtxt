          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "- **`src/core/data/tilesets.ts`**:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  - Tileset urbano `urban_ruins` com 11 presets t\303\241teis pr\303\251-configurados:"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    - Asfalto limpo, Asfalto rachado, Cal\303\247ada de concreto"
