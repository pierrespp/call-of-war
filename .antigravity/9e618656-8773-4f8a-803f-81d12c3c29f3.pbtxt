        lines {
          text: "  const steps = Math.max(2, Math.ceil(dist / (CELL_SIZE / 4)));"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const startCell = `${Math.floor(sx / CELL_SIZE)},${Math.floor(sy / CELL_SIZE)}`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const endCell = `${Math.floor(tx / CELL_SIZE)},${Math.floor(ty / CELL_SIZE)}`;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  for (let i = 0; i <= steps; i++) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const t = i / steps;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const cx = sx + (tx - sx) * t;"
