        lines {
          text: "// \342\224\200\342\224\200\342\224\200 Draft validation (max 9 units, max 100 pts) \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
