      target_content: "// \342\224\200\342\224\200 Persistent storage for per-map grid display settings (Map Editor) \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200"
      replacement_content: "// \342\224\200\342\224\200 Persistent storage for per-map tile data (Map Editor) \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\n\nconst tileLookupCache = createTileLookup(BUILTIN_TILESETS);\n\nasync function loadGlobalTileData(): Promise<Record<string, MapTileData>> {\n  const out: Record<string, MapTileData> = {};\n  try {\n    const col = collection(db, \"map-tiles\");\n    const snap = await getDocs(col);\n    snap.docs.forEach((d) => {\n      out[d.id] = d.data() as MapTileData;\n    });\n  } catch (err) {\n    console.error(\"\342\232\240\357\270\217 Falha ao ler map-tiles do Firestore:\", err);\n  }\n  return out;\n}\n\nasync function saveMapTileData(mapId: string, data: MapTileData) {\n  globalTileData[mapId] = data;\n  try {\n    await setDoc(doc(db, \"map-tiles\", mapId), data);\n  } catch (err) {\n    console.error(`\342\232\240\357\270\217 Falha ao salvar map-tiles no Firestore (${mapId}):`, err);\n  }\n}\n\n// \342\224\200\342\224\200 Persistent storage for per-map grid display settings (Map Editor) \342\224\200\342\224\200\342\224\200\342\224\200\342\224\200\342\224\200"
