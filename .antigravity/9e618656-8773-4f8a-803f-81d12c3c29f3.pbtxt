        }
        lines {
          text: "  - Fun\303\247\303\243o `deriveCoverDataFromTiles` que traduz os tiles pintados para a engine de combate (`MapCoverData`), preservando as zonas de deploy (`deployA`, `deployB`), zonas de spawn de zumbis (`spawn_pve`) e extra\303\247\303\243o (`extraction`)."
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
