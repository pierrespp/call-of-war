        lines {
          text: "  const dist = Math.hypot(tx - sx, ty - sy);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  if (dist === 0) return false;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
