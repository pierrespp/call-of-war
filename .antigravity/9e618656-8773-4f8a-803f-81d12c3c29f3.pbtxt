  file_change {
    absolute_path_uri: "file:///server.ts"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "async function loadGlobalCoverData(): Promise<\n  Record<string, Record<string, string>>\n> {\n  const out: Record<string, Record<string, string>> = {};\n\n  // Try Firestore first\n  try {\n    const col = collection(db, \"map-covers\");\n    const snap = await getDocs(col);\n    snap.docs.forEach((d) => {\n      out[d.id] = d.data() as Record<string, string>;\n    });\n  } catch (err) {\n    console.error(\"\342\232\240\357\270\217 Falha ao ler coberturas do Firestore:\", err);\n  }\n\n  return out;\n}\n\nasync function saveMapCover(mapId: string, data: Record<string, string>) {\n  // Update global cache\n  globalCoverData[mapId] = data;\n\n  // Save to Firestore (specific cover collection)\n  try {\n    await setDoc(doc(db, \"map-covers\", mapId), data);\n  } catch (err) {\n    console.error(`\342\232\240\357\270\217 Falha ao salvar cobertura no Firestore (${mapId}):`, err);\n  }\n\n  // If it\'s an AI map, also update its metadata record to keep them in sync\n  if (mapId.startsWith(\"ai_\")) {\n    try {\n      const records = await loadAIMapRecords();\n      const record = records.find((r) => r.id === mapId);\n      if (record) {\n        record.coverData = data;\n        await persistAIMapRecord(record);\n      }\n    } catch (err) {\n      console.error(\n        `\342\232\240\357\270\217 Falha ao sincronizar registro de metadados do mapa IA (${mapId}):`,\n        err,\n      );\n    }\n  }\n}"
      replacement_content: "async function loadGlobalCoverData(): Promise<\n  Record<string, MapCoverData>\n> {\n  const out: Record<string, MapCoverData> = {};\n\n  // Try Firestore first\n  try {\n    const col = collection(db, \"map-covers\");\n    const snap = await getDocs(col);\n    snap.docs.forEach((d) => {\n      out[d.id] = d.data() as MapCoverData;\n    });\n  } catch (err) {\n    console.error(\"\342\232\240\357\270\217 Falha ao ler coberturas do Firestore:\", err);\n  }\n\n  return out;\n}\n\nasync function saveMapCover(mapId: string, data: MapCoverData) {\n  // Update global cache\n  globalCoverData[mapId] = data;\n\n  // Save to Firestore (specific cover collection)\n  try {\n    await setDoc(doc(db, \"map-covers\", mapId), data);\n  } catch (err) {\n    console.error(`\342\232\240\357\270\217 Falha ao salvar cobertura no Firestore (${mapId}):`, err);\n  }\n\n  // If it\'s an AI map, also update its metadata record to keep them in sync\n  if (mapId.startsWith(\"ai_\")) {\n    try {\n      const records = await loadAIMapRecords();\n      const record = records.find((r) => r.id === mapId);\n      if (record) {\n        record.coverData = data;\n        await persistAIMapRecord(record);\n      }\n    } catch (err) {\n      console.error(\n        `\342\232\240\357\270\217 Falha ao sincronizar registro de metadados do mapa IA (${mapId}):`,\n        err,\n      );\n    }\n  }\n}\n"
    }
